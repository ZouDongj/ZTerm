# Local-only development notes repository (docs, design prototypes,
# diagnostic probes, field evidence). Tracked by dev/.git, never pushed.
dev/

# Runtime scratch for the e2e sandbox and probes (auto-cleaned after runs)
artifacts/

# Tauri migration (tauri-migration branch)
# target/ holds all Rust build output + dependency caches (hundreds of MB)
# src-tauri/gen/ is Tauri-generated (capabilities schema, acl-manifests, ...)
# Cargo.lock IS committed on purpose: reproducible builds per Tauri docs.
src-tauri/target/
src-tauri/gen/
