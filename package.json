{
  "name": "zterm",
  "version": "1.0.1",
  "description": "ZTerm — A modern terminal emulator for Windows with SSH management, split panes, and SFTP",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [
    "terminal",
    "ssh",
    "sftp",
    "windows",
    "electron"
  ],
  "author": "zoudongjie <zoudongjie96@163.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZouDongj/zterm"
  },
  "bugs": {
    "url": "https://github.com/ZouDongj/zterm/issues"
  },
  "homepage": "https://github.com/ZouDongj/zterm#readme",
  "type": "commonjs",
  "build": {
    "appId": "com.zterm.app",
    "productName": "ZTerm",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "node_modules/{node-pty,russh,fontmanager-redux}/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ZTerm"
    }
  },
  "dependencies": {
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.4.0",
    "fontmanager-redux": "^1.1.0",
    "node-pty": "^1.1.0",
    "russh": "0.1.37",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  }
}
