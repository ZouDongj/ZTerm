{
  "productName": "ZTerm",
  "version": "1.2.1",
  "identifier": "com.zterm.tauri.app",
  "mainBinaryName": "zterm",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../build/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "template": "./nsis/installer.nsi",
        "languages": ["SimpChinese", "English"],
        "customLanguageFiles": {
          "SimpChinese": "./installer-languages/SimpChinese.nsh",
          "English": "./installer-languages/English.nsh"
        },
        "installerHooks": "./installer.nsh",
        "installerIcon": "../build/icon.ico",
        "uninstallerIcon": "../build/icon.ico"
      }
    }
  }
}
